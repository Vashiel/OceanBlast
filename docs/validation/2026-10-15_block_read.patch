+    // Borrowed only for one instruction. Do not retain across mode, mapping or
+    // peripheral changes. One 1-KB subregion has uniform cached access rights.
+    inline const u8* tryReadRamSpan(u32 addr, unsigned bytes) {
+        if (bytes == 0 || bytes > 1024 || (addr & 3) || (addr & 1023) > 1024 - bytes)
+            return nullptr;
+        MmuFault fault = MmuFault::NONE;
+        const u32 pa = translate(addr, &fault);
+        if (fault != MmuFault::NONE || pa < ADDR_SDRAM_BASE ||
+            pa - ADDR_SDRAM_BASE > ADDR_SDRAM_SIZE - bytes)
+            return nullptr;
+        lastFault = MmuFault::NONE;
+        return sdramPtr + (pa - ADDR_SDRAM_BASE);
