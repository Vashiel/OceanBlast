@@ -0,0 +1,19 @@
+#include "cpu/arm_decoded_blocks.h"
+#include <iostream>
+using namespace oceanblast;
+int main() {
+    ArmDecodedBlocks blocks; ARM920TState state;
+    state.r[0]=3; state.cpsr=0xf00000d3;
+    bool ok=blocks.execute(state,0,0xe2800001) && state.r[0]==4 && state.r[15]==4;
+    state.r[0]=10;
+    ok=ok && blocks.execute(state,0,0xe2800001) && state.r[0]==11;
+    ok=ok && blocks.execute(state,0,0xe2400002) && state.r[0]==9;
+    ok=ok && blocks.execute(state,0x4000,0xe3a004ff) && state.r[0]==0xff000000 && state.r[15]==0x4004;
+    ok=ok && !blocks.execute(state,0,0xe2900001) && state.r[0]==0xff000000;
+    ok=ok && !blocks.execute(state,0,0x02800001) && state.r[0]==0xff000000;
+    ok=ok && !blocks.execute(state,0,0xe28f0001) && state.r[0]==0xff000000;
+    ok=ok && !blocks.execute(state,0,0xe280f001) && state.r[15]==0x4004;
+    ok=ok && state.cpsr==0xf00000d3;
+    std::cout << (ok?"PASS ":"FAIL ") << "decoded block reuse, changed code, collisions and fallback guards\n";
+    return ok?0:1;
+}
