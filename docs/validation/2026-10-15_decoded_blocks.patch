+++ b/src/cpu/arm_decoded_blocks.h
@@ -0,0 +1,64 @@
+#pragma once
+#include "arm920t_state.h"
+#include <array>
+
+namespace oceanblast {
+// Lazily decode 16-instruction ARM blocks. Fetch and permission checks still
+// occur for every instruction; exact word validation handles modified code.
+class ArmDecodedBlocks {
+public:
+    bool execute(ARM920TState& state, u32 pc, u32 instruction) {
+        auto& block=blocks[(pc>>6)&255];
+        const u32 tag=pc>>6, index=(pc>>2)&15, mask=1u<<index;
+        if (block.tag!=tag) { block.tag=tag; block.valid=0; }
+        auto& decoded=block.instructions[index];
+        if (!(block.valid&mask) || decoded.word!=instruction) {
+            decoded=decode(instruction);
+            block.valid|=mask;
+        }
+        if (!decoded.supported) return false;
+        const u32 left=state.r[decoded.rn], right=decoded.immediate;
+        u32 result=0;
+        switch (decoded.opcode) {
+            case 0: result=left&right; break;
+            case 1: result=left^right; break;
+            case 2: result=left-right; break;
+            case 3: result=right-left; break;
+            case 4: result=left+right; break;
+            case 12: result=left|right; break;
+            case 13: result=right; break;
+            case 14: result=left&~right; break;
+            case 15: result=~right; break;
+        }
+        state.r[decoded.rd]=result;
+        state.r[15]=pc+4;
+        return true;
+    }
+private:
+    struct Decoded {
+        u32 word=0, immediate=0;
+        u8 opcode=0, rn=0, rd=0;
+        bool supported=false;
+    };
+    struct Block {
+        u32 tag=UINT32_MAX, valid=0;
+        std::array<Decoded,16> instructions;
+    };
+    std::array<Block,256> blocks;
+
+    static Decoded decode(u32 instruction) {
+        Decoded result;
+        result.word=instruction;
+        if ((instruction&0xfe100000)!=0xe2000000) return result;
+        result.opcode=(instruction>>21)&15;
+        result.rn=(instruction>>16)&15;
+        result.rd=(instruction>>12)&15;
+        if (result.rn==15 || result.rd==15 ||
+            (result.opcode>=5 && result.opcode<=11)) return result;
+        const u32 rotation=((instruction>>8)&15)*2, value=instruction&255;
+        result.immediate=rotation?(value>>rotation)|(value<<(32-rotation)):value;
+        result.supported=true;
+        return result;
+    }
+};
+}
