@@ -61,0 +64,35 @@
+    // A completed group has one timed step followed by Ratio-1 zero-time steps.
+    // Commit a partial phase if execution halts between any two instructions.
+    template<size_t Ratio, size_t Index = 1>
+    bool finishLegacyGroup(size_t& retired, size_t& phase) {
+        if constexpr (Index == Ratio) {
+            phase = 0;
+            return true;
+        } else {
+            if (cpu.isHalted()) { phase = Index; return false; }
+            cpu.step(0);
+            ++retired;
+            return finishLegacyGroup<Ratio, Index+1>(retired, phase);
+        }
+    }
+
+    template<size_t Ratio>
+    size_t runLegacyFixed(size_t budget, size_t& phase, uint64_t& guestTicks) {
+        size_t retired = 0;
+        while (phase && retired < budget && !cpu.isHalted()) {
+            stepLegacy(Ratio, phase, guestTicks);
+            ++retired;
+        }
+        while (budget-retired >= Ratio && !cpu.isHalted()) {
+            cpu.step(1);
+            ++guestTicks;
+            ++retired;
+            if (!finishLegacyGroup<Ratio>(retired, phase)) return retired;
+        }
+        while (retired < budget && !cpu.isHalted()) {
+            stepLegacy(Ratio, phase, guestTicks);
+            ++retired;
+        }
+        return retired;
+    }
